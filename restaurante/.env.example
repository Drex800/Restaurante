# Copie este archivo a .env y cambie TODOS los valores. El .env nunca se sube a Git.
#   cp .env.example .env
#
# Para generar secretos largos:   openssl rand -hex 32

# Contraseñas de las tres bases de datos (una por servicio)
DB_USUARIOS_PASSWORD=usarios                                                 
DB_PRODUCTOS_PASSWORD=contraseña-productos --- IGNORE ---
DB_PEDIDOS_PASSWORD=contraseña-pedidos --- IGNORE ---

# Secreto con el que se firman y verifican los tokens JWT (mínimo 32 caracteres)
JWT_SECRET=cambiar-este-secreto-jwt-por-uno-largo-y-aleatorio --- IGNORE ---
JWT_EXPIRE_MINUTES=60

# Token interno para que "pedidos" registre salidas de inventario en "productos"
SERVICE_TOKEN=cambiar-este-token-de-servicio-interno --- IGNORE ---

# Administrador inicial (se crea al primer arranque si no existe)
ADMIN_EMAIL=corroadmin@.com
ADMIN_PASSWORD=contraseña-admin--- IGNORE ---
